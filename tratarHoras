import pandas as pd
from datetime import datetime
from dateutil.relativedelta import relativedelta

# Leer el archivo Excel
df = pd.read_excel("overview".xlsx", engine="openpyxl")

# Asegurarse de que los nombres de columnas estén limpios df.columns = df.columns.str.strip().str.lower()

# Crear columna fecha a partir de año y mes df["fecha"] = pd.to_datetime(df["año"].astype(str) + "-" + df["mes"].astype(str) + "-01")

# Filtrar últimos 12 meses
hoy = datetime.today()
hace_12_meses = hoy - relativedelta(months=12) df_12m = df[df["fecha"] >= hace_12_meses]

# Normalizar actividad en minúsculas
df_12m["actividad"] = df_12m["actividad"].str.strip().str.lower()

# Clasificar actividades
df_12m["es_mantenimiento"] = df_12m["actividad"] == "mantenimiento"
df_12m["es_extensivo"] = df_12m["actividad"] == "extensivo"
df_12m["es_cbk"] = df_12m["actividad"].isin(["cbk1", "cbk2", "cbk3"])

# Agrupar y sumar por Id y nombre
resumen = df_12m.groupby(["id", "nombre"]).apply(lambda x: pd.Series({
    "horas_mantenimiento": x.loc[x["es_mantenimiento"], "horas"].sum(),
    "horas_extensivo": x.loc[x["es_extensivo"], "horas"].sum(),
    "horas_cbk": x.loc[x["es_cbk"], "horas"].sum()
})).reset_index()

# Guardar el resultado
resumen.to_excel("resumen_12_meses.xlsx", index=False)

